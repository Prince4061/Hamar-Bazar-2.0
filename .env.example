# ── Hamar Bazar 2.0 — production environment (copy to .env, never commit .env) ──

# Flask session signing key. Generate once:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Admin panel login (/staff-login -> Admin). REQUIRED in production.
# If ADMIN_PASSWORD is empty, a random password is generated on first start and printed in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SQLite database location (inside the docker volume)
DATABASE_PATH=/app/data/marketplace.db

# Demo data: '1' creates the sample shops/customers/riders that all use the password "password123".
# Keep '0' for the live Play Store app.
SEED_DEMO_DATA=0

# Cloudflare tunnel token (docker-compose "tunnel" service)
TUNNEL_TOKEN=

# Optional: Razorpay (online payments are currently disabled in the app; COD only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
